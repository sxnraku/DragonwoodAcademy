# Nivel 1 da cascata de IA — Google Gemini.
# Obtem uma chave em https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Nivel 2 (opcional) — proxy local compativel com Ollama.
# Por omissao aponta para a porta nativa do Ollama. NAO uses a porta 3000:
# e a mesma do dev server do Vite e o pedido bate no proprio servidor.
# VITE_AI_PROXY_URL=http://localhost:11434/api/generate
# VITE_OLLAMA_MODEL=llama3
